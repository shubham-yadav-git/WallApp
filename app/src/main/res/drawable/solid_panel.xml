<?xml version="1.0" encoding="utf-8"?>
<!-- Close-up info panel when animations are off: solid instead of glass -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface" />
    <stroke android:width="1px" android:color="@color/outline" />
    <corners
        android:topLeftRadius="@dimen/glass_panel_radius"
        android:topRightRadius="@dimen/glass_panel_radius"
        android:bottomLeftRadius="@dimen/glass_panel_bottom_radius"
        android:bottomRightRadius="@dimen/glass_panel_bottom_radius" />
</shape>
