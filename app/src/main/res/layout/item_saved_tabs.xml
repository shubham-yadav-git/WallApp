<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingHorizontal="4dp"
    android:paddingBottom="8dp"
    android:scrollbars="none">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/saved_tabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/tab_favorites"
            style="@style/Widget.App.CategoryChip"
            android:layout_width="wrap_content"
            android:text="@string/tab_favourites" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tab_collections"
            style="@style/Widget.App.CategoryChip"
            android:layout_width="wrap_content"
            android:text="@string/tab_collections" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tab_recent"
            style="@style/Widget.App.CategoryChip"
            android:layout_width="wrap_content"
            android:text="@string/tab_recent" />

    </com.google.android.material.chip.ChipGroup>

</HorizontalScrollView>
