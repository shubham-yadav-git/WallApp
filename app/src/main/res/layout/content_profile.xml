<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Account: signed out -->
    <LinearLayout
        android:id="@+id/account_signed_out"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_side_padding"
        android:layout_marginTop="4dp"
        android:background="@drawable/pill_soft_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync_banner_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/onSurface"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sync_banner_text"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/onSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/account_google"
            style="@style/Widget.App.Pill.Ink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/continue_with_google"
            app:icon="@drawable/ic_google_g"
            app:iconTint="@null" />

    </LinearLayout>

    <!-- Account: signed in -->
    <LinearLayout
        android:id="@+id/account_signed_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_side_padding"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <TextView
                android:id="@+id/account_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/brand_mark_bg"
                android:backgroundTint="@color/onSurface"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/account_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Pill" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/account_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/onSurface"
                android:textStyle="bold"
                tools:text="Shubham" />

            <TextView
                android:id="@+id/account_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/onSurfaceVariant"
                tools:text="someone@gmail.com" />

            <TextView
                android:id="@+id/account_sync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/onSurfaceVariant"
                tools:text="Saved items synced" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/account_sign_out"
        style="@style/Widget.App.Pill.Small.Soft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="88dp"
        android:text="@string/sign_out"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="@dimen/screen_side_padding"
        android:paddingBottom="4dp"
        android:text="@string/settings_section_appearance"
        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

    <LinearLayout
        android:id="@+id/row_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_side_padding">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dark_mode_24"
            app:tint="@color/onSurface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/onSurface" />

            <TextView
                android:id="@+id/theme_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/onSurfaceVariant"
                tools:text="System default" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="@dimen/screen_side_padding"
        android:paddingBottom="4dp"
        android:text="@string/settings_section_wallpaper"
        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

    <!-- Daily auto wallpaper toggle -->
    <LinearLayout
        android:id="@+id/row_auto_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_side_padding">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_autorenew_24"
            app:tint="@color/onSurface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_wallpaper_title"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/onSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_wallpaper_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/onSurfaceVariant" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_auto_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

    <TextView
        android:id="@+id/row_run_now"
        style="@style/Widget.App.SettingsRow"
        android:drawableStart="@drawable/ic_wallpaper_white_24dp"
        android:text="@string/auto_wallpaper_run_now" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="@dimen/screen_side_padding"
        android:paddingBottom="4dp"
        android:text="@string/settings_section_app"
        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

    <TextView
        android:id="@+id/row_check_update"
        style="@style/Widget.App.SettingsRow"
        android:drawableStart="@drawable/ic_update_24"
        android:text="@string/check_for_updates" />

    <TextView
        android:id="@+id/row_rate"
        style="@style/Widget.App.SettingsRow"
        android:drawableStart="@drawable/ic_rate_review_24dp"
        android:text="@string/nav_rate_app" />

    <TextView
        android:id="@+id/row_share"
        style="@style/Widget.App.SettingsRow"
        android:drawableStart="@drawable/ic_share_white_24dp"
        android:text="@string/nav_share_friends" />

    <TextView
        android:id="@+id/row_feedback"
        style="@style/Widget.App.SettingsRow"
        android:drawableStart="@drawable/ic_contact_mail"
        android:text="@string/nav_send_feedback" />

    <TextView
        android:id="@+id/row_privacy"
        style="@style/Widget.App.SettingsRow"
        android:drawableStart="@drawable/ic_shield_24"
        android:text="@string/nav_privacy_policy" />

    <TextView
        android:id="@+id/version_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:textColor="@color/onSurfaceVariant"
        tools:text="Version 1.2.7" />

</LinearLayout>
