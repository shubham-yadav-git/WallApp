<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Neutral, image-first palette: the wallpapers carry the color -->
    <color name="primary">#E60023</color>
    <color name="onPrimary">#FFFFFF</color>
    <color name="primaryContainer">#93000F</color>
    <color name="onPrimaryContainer">#FFDAD6</color>

    <color name="secondary">#B5B5B5</color>
    <color name="onSecondary">#111111</color>
    <color name="secondaryContainer">#3A3A3A</color>
    <color name="onSecondaryContainer">#EFEFEF</color>

    <color name="background">#111111</color>
    <color name="onBackground">#EFEFEF</color>
    <color name="surface">#111111</color>
    <color name="onSurface">#EFEFEF</color>
    <color name="surfaceVariant">#2A2A2A</color>
    <color name="onSurfaceVariant">#B5B5B5</color>
    <color name="outline">#4A4A4A</color>

    <!-- Material 3 surface containers (bottom nav, dialogs, sheets) -->
    <color name="surfaceContainerLowest">#0B0B0B</color>
    <color name="surfaceContainerLow">#161616</color>
    <color name="surfaceContainer">#111111</color>
    <color name="surfaceContainerHigh">#222222</color>
    <color name="surfaceContainerHighest">#2A2A2A</color>

    <!-- Placeholder shown behind pins while images load -->
    <color name="pinPlaceholder">#262626</color>

    <!-- Dark Mode Splash Background -->
    <color name="splash_background">#1C1B1F</color>

    <!-- App Icon Colors synchronized with Splash Background -->
    <color name="ic_launcher_background">@color/splash_background</color>

    <!-- Legacy support -->
    <color name="colorPrimary">@color/primary</color>
    <color name="colorPrimaryDark">#000000</color>
    <color name="colorAccent">@color/primary</color>
